    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  o.order_id,\n  o.source,\n  o.order_date,\n  o.buyer_name,\n  o.buyer_email,\n  o.buyer_city,\n  o.buyer_zip,\n  o.buyer_country,\n  o.items_json,\n  o.subtotal,\n  o.shipping_cost,\n  o.total,\n  o.currency,\n  o.status,\n  o.tracking_number,\n  o.carrier,\n  o.invoice_number,\n  o.is_digital,\n  o.notion_page_id,\n  (SELECT value FROM app_config WHERE scope = 'notion' AND key = 'database_id') AS notion_database_id\nFROM orders o\nWHERE o.source = 'etsy'\n  -- notion_page_id IS NULL: Bestellungen, deren Anlage in Notion früher\n  -- fehlgeschlagen ist oder die außerhalb des 2h-Fensters lagen (n8n-Ausfall),\n  -- werden nachgeholt statt dauerhaft zu fehlen.\n  AND (o.updated_at > NOW() - INTERVAL '2 hours' OR o.notion_page_id IS NULL)\nORDER BY o.updated_at DESC\nLIMIT 200;",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "Geänderte Orders holen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 300],
