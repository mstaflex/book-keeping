      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Neue / geänderte Orders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// PII-Anonymisierung für Notion (DSGVO-konform)\n// Was bleibt:    Pseudonym, Stadt, Land, PLZ-Präfix (erste 2 Stellen), Finanzen, Status\n// Was entfällt:  Vollname, E-Mail, Straße, vollständige PLZ\n\nfunction pseudonym(name, email) {\n  // Stabile Pseudonymisierung via FNV-1a (kein Node-crypto im n8n-Sandbox).\n  // 32-bit Hash → 8 Hex-Zeichen, z.B. \"Kunde-3f7a2b1c\"\n  const seed = (email || name || String(Math.random())).toLowerCase().trim();\n  let h = 0x811c9dc5;\n  for (let i = 0; i < seed.length; i++) {\n    h ^= seed.charCodeAt(i);\n    h = Math.imul(h, 0x01000193);\n  }\n  const hash = (h >>> 0).toString(16).padStart(8, '0');\n  return `Kunde-${hash}`;\n}\n\nreturn $input.all().map(item => {\n  const o = item.json;\n\n  // PLZ: nur erste 2 Zeichen (z.B. \"80\" statt \"80331\")\n  const zipPrefix = o.buyer_zip ? String(o.buyer_zip).slice(0, 2) + 'xxx' : null;\n\n  // Items: Titel + Menge behalten, Preise OK (keine PII)\n  let items = [];\n  if (Array.isArray(o.items_json)) {\n    items = o.items_json;\n  } else if (typeof o.items_json === 'string') {\n    try { items = JSON.parse(o.items_json); } catch (e) {}\n  }\n  const itemsSummary = items.map(i => `${i.quantity}x ${i.title}`).join(', ');\n\n  return {\n    json: {\n      // Identifikatoren\n      order_id:           o.order_id,\n      notion_page_id:     o.notion_page_id ?? null,\n      notion_database_id: o.notion_database_id,\n      source:             o.source,\n      // Anonymisiert\n      pseudonym:      pseudonym(o.buyer_name, o.buyer_email),\n      city:           o.buyer_city ?? null,\n      zip_prefix:     zipPrefix,\n      country:        o.buyer_country ?? null,\n      // Geschäftsdaten (kein PII)\n      order_date:     o.order_date,\n      status:         o.status,\n      subtotal:       o.subtotal,\n      shipping_cost:  o.shipping_cost,\n      total:          o.total,\n      currency:       o.currency,\n      items_summary:  itemsSummary,\n      is_digital:     o.is_digital,\n      tracking_number: o.tracking_number ?? null,\n      carrier:        o.carrier ?? null,\n      invoice_number: o.invoice_number ?? null,\n    }\n  };\n});\n"
      },
