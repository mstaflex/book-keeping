# =============================================================================
# .env.example – Vorlage. Kopie als .env neben die docker-compose.yml legen
# oder die Variablen im Hosting-Panel beim Compose-Projekt eintragen.
# NIE eine ausgefüllte .env committen (steht in .gitignore).
#
# Alle Variablen sind optional; leere oder fehlende werden übersprungen.
# =============================================================================

# ---------------------------------------------------------------------------
# 1) Datenbank-Zugang – wirkt NUR beim allerersten Start (leeres Volume).
#    Fehlt etwas, nimmt bootstrap Standardnamen (orderdb / root / buschi) und
#    erzeugt Passwörter; ausgegeben einmalig in: docker compose logs bootstrap
#    Spätere Änderungen hier haben keine Wirkung mehr.
# ---------------------------------------------------------------------------
# DB_NAME=orderdb
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=
# DB_WORKER_USER=buschi
# DB_WORKER_PASSWORD=

# ---------------------------------------------------------------------------
# 2) App-Konfiguration – wird bei JEDEM Start nach app_config geschrieben
#    (Container app-config, README Schritt 5). Darf nach dem ersten Start
#    nachgetragen werden. Nach Änderungen: docker compose up -d
#    (ein "docker compose restart" übernimmt geänderte Werte NICHT).
# ---------------------------------------------------------------------------
# ETSY_API_KEY=keystring:shared_secret
# ETSY_SHOP_ID=12345678
# Startdatum (YYYY-MM-DD) für den ersten Abruf von Bestellungen und Ledger
# (Workflows 01, 02), ohne: die letzten 90 Tage
# ETSY_SYNC_START=2026-01-01
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absender / Empfänger der Rechnungs-Mails (Workflows 04, 05)
# MAIL_FROM=rechnungen@example.org
# MAIL_TO=buchhaltung@example.org

# Verkäuferdaten für Rechnung und Lieferschein (Pflicht: NAME, STREET, ZIP, CITY)
# SELLER_NAME=Vorname Nachname
# SELLER_BUSINESS_NAME=Mein Shop
# SELLER_TAGLINE=
# SELLER_STREET=Strasse 1
# SELLER_ZIP=12345
# SELLER_CITY=Stadt
# SELLER_COUNTRY=Deutschland
# SELLER_EMAIL=shop@example.org
# SELLER_PHONE=
# SELLER_WEBSITE=
# SELLER_IBAN=DE00 0000 0000 0000 0000 00
# SELLER_BANK_NAME=Bank
# SELLER_TAX_ID=123/456/78901
# SELLER_VAT_ID=DE123456789
# SELLER_KLEINUNTERNEHMER=true

# Reverse-Charge-Monatsrechnung an Etsy (Workflow 05) – Werte mit den eigenen
# bisherigen Rechnungen an Etsy abgleichen
# ETSY_RC_RECIPIENT_NAME=Etsy Ireland UC
# ETSY_RC_RECIPIENT_STREET=One Le Pole Square, Ship Street Great
# ETSY_RC_RECIPIENT_ZIP=
# ETSY_RC_RECIPIENT_CITY=Dublin 8
# ETSY_RC_RECIPIENT_COUNTRY=Irland
# ETSY_RC_RECIPIENT_VAT_ID=IE9777587C
# ETSY_RC_START_DATE=2026-10-01
# Rechnungsnummer: {YYYY} = Jahr der Rechnungsstellung, {NN} = eigener laufender
# Zähler der Etsy-Rechnungen im Jahr (Standard: RE-E-{YYYY}-{NN})
# ETSY_RC_NUMBER_FORMAT=RE-E-{YYYY}-{NN}

# Kundenrechnungen (Workflow 04): {YYYY} = Jahr, {NNN} = laufender Zähler des
# Jahres mit so vielen Stellen wie N (Standard: BC-E-{YYYY}-{NNN})
# INVOICE_NUMBER_FORMAT=BC-E-{YYYY}-{NNN}
# ETSY_RC_PAYMENT_NOTE=
# ETSY_RC_NOTE=

# Etsy-Zahlungskonto → Lexoffice (Workflow 06): erster Monat, der über die
# Monats-CSV nach Lexoffice kommt (YYYY-MM). Alles davor ist bereits gebucht
# (z.B. über PayJoe) und wird nie exportiert.
# LEXOFFICE_START_MONTH=2026-10
