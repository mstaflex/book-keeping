            { "key": "Bestelldatum|date",      "type": "date",   "date": "={{ $json.order_date }}", "timezone": "Etc/Zulu" },
            { "key": "Pseudonym|rich_text",    "textContent": "={{ $json.pseudonym }}" },
            { "key": "Stadt|rich_text",        "textContent": "={{ $json.city }}" },
            { "key": "PLZ|rich_text",          "textContent": "={{ $json.zip_prefix }}" },
            { "key": "Land|rich_text",         "textContent": "={{ $json.country }}" },
            { "key": "Currency|rich_text",     "textContent": "={{ $json.currency }}" },
            { "key": "Versand|number",         "numberValue": "={{ parseFloat($json.shipping_cost) || 0 }}" },
            { "key": "Artikel|rich_text",      "textContent": "={{ $json.items_summary }}" },
            { "key": "Digital|checkbox",       "checkboxValue": "={{ $json.is_digital }}" },
            { "key": "Rechnungsnr.|rich_text", "textContent": "={{ $json.invoice_number || '' }}" },
            { "key": "Tracking|rich_text",     "textContent": "={{ $json.tracking_number || '' }}" },
            { "key": "OrderID|title",          "title": "={{ $json.order_id }}" },
            { "key": "Versanddienstl.|rich_text", "textContent": "={{ $json.carrier || '' }}" },
            { "key": "Gesamt|number",          "numberValue": "={{ parseFloat($json.total) || 0 }}" }
          ]
        }
