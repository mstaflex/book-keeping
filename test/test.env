# =============================================================================
# test/test.env – feste Werte für die lokale Testumgebung (test/docker-compose.yml)
# Nur ausgedachte Testdaten. Hier nie echte Werte eintragen: diese Datei ist
# im Repository.
# =============================================================================

# Datenbank (bootstrap, nur Testpasswörter)
DB_NAME=orderdb
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=test-admin-pw
DB_WORKER_USER=worker
DB_WORKER_PASSWORD=test-worker-pw

# Login für die Test-n8n unter http://localhost:5678
TEST_LOGIN_EMAIL=test@example.org
TEST_LOGIN_PASSWORD=Testpass123

# App-Konfiguration (Config-Loader schreibt sie wie im Betrieb nach app_config)
ETSY_API_KEY=test-keystring:test-shared-secret
ETSY_SHOP_ID=12345678
# Notion wird offline nicht getestet (Workflow 03 wird nicht importiert)
NOTION_DATABASE_ID=test-notion-db
MAIL_FROM=rechnungen@example.org
MAIL_TO=buchhaltung@example.org
SELLER_NAME=Max Mustermann
SELLER_BUSINESS_NAME=Mein Shop
SELLER_STREET=Musterstraße 1
SELLER_ZIP=12345
SELLER_CITY=Musterstadt
SELLER_COUNTRY=Deutschland
SELLER_EMAIL=shop@example.org
SELLER_IBAN=DE00 0000 0000 0000 0000 00
SELLER_BANK_NAME=Musterbank
SELLER_TAX_ID=123/456/78901
SELLER_VAT_ID=DE123456789
SELLER_KLEINUNTERNEHMER=true
ETSY_RC_RECIPIENT_NAME=Etsy Ireland UC
ETSY_RC_RECIPIENT_STREET=One Le Pole Square, Ship Street Great
ETSY_RC_RECIPIENT_CITY=Dublin 8
ETSY_RC_RECIPIENT_COUNTRY=Irland
ETSY_RC_RECIPIENT_VAT_ID=IE9777587C
ETSY_RC_START_DATE=2020-01-01
LEXOFFICE_START_MONTH=2020-01
